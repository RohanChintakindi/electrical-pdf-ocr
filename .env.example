# For Vercel deployment, paste the *contents* of the service account JSON here
# (NOT a path). It will be written to /tmp on cold start.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# For local dev, you can point at the file directly instead:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Required for Claude legend auto-discovery. Falls back to regex-only filter if missing.
ANTHROPIC_API_KEY=

# Auto-set by Vercel when Blob storage is enabled. Leave unset for local dev —
# the app falls back to .local-blob/ on disk.
BLOB_READ_WRITE_TOKEN=
